__MAPS__

































































































































__LUA__
__SECTION__
-- your first Nano-8 lua code
function _init()
  player = {
    x=64,
    y=64
  }
end

function _update()
  if btn(K_L) then
    player.x = player.x - 1
  elseif btn(K_R) then
    player.x = player.x + 1
  elseif btn(K_U) then
    player.y = player.y - 1
  elseif btn(K_D) then
    player.y = player.y + 1
  end
end

function _draw()
  cls()
  camera(player.x-64, player.y-64)
  map(0,0,0,0,16,16)
  spr(0, player.x, player.y)
  print("position " ..player.x .. " " .. player.y)
end
