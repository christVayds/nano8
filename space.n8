__MAPS__

































































































































__SFX__

__MUSIC__

__LUA__
__SECTION__
-- main
function _init()
  player = newPlayer()
  
  initRain()
end

function _update()
  updatePlayer(player)
  
  for i=1,#player.bullets do
    updateBullet(player.bullets[i])
  end

  updateRain()
end

function _draw()
  cls()
  drawRain()
  drawPlayer(player)
  for i=1,#player.bullets do
    drawBullet(player.bullets[i])
  end
end
__SECTION__
-- player
speed = 2

function newPlayer()
  local player = {
    x=64,
    y=96,
    life=3,
    sp=0,
    bullets = {}
  }
    
  return player
end

function updatePlayer(player)
  if btn(K_L) then
    player.x = player.x - speed
  elseif btn(K_R) then
    player.x = player.x + speed
  end
  
  if btnp(K_X) then
    sfx(0)
    table.insert(player.bullets, newBullet(player.x, player.y))
   end
end

function drawPlayer(player)
  spr(player.sp, player.x, player.y)
end
__SECTION__
-- bullet
function newBullet(px, py)
  local bullet = {
    x=px,
    y=py,
    r=5
  }
  return bullet
end

function updateBullet(bullet)
  bullet.y = bullet.y-5
end

function drawBullet(bullet)
  spr(16, bullet.x, bullet.y)
end
__SECTION__
-- effects
rain = {}
rainCount = 10

function initRain()
  for i=1,rainCount do
    local newRain = {
      x=rand(128),
      y=rand(128) -128
    }
    table.insert(rain, newRain)
  end
end

function updateRain()
  for i=1,rainCount do
    rain[i].y = rain[i].y + 5
    
    if rain[i].y > 128 then
      rain[i].x = rand(128)
      rain[i].y = rand(128)-128
    end
  end
end

function drawRain()
  for i=1,rainCount do
    local x = rain[i].x
    local y = rain[i].y
    rectfill(x, y, x+1, y+1, 6)
  end
end
